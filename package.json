{
  "name": "dbd-blocker",
  "version": "1.4.0",
  "description": "DBD Server Blocker - block AWS regions for Dead by Daylight",
  "author": "steaxs",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "npm run typecheck",
    "test": "npm run typecheck && npm run test:unit && npm run build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "dist:publish": "electron-vite build && electron-builder --win --publish always",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "country-flag-icons": "^1.6.15",
    "electron-updater": "^6.8.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "polylabel": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
